# Copy to .env and fill in locally. .env is git-ignored.

# LLM access (de-identified text only) — see docs/architecture.md decisions 5–7, 15
OPENROUTER_API_KEY=
# Primary vs fallback is decided by the W1 model comparison (decision 6)
LLM_PRIMARY_MODEL=anthropic/claude-haiku-5.5
LLM_FALLBACK_MODEL=openai/gpt-6-luna
LLM_BUDGET_USD_HARD_STOP=2.00

# Tracing — decision 10
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sahyog-care-companion

# Embeddings — decision 8 (runs locally)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Queue and slot cache — decisions 11 and 16
REDIS_URL=redis://localhost:6379/0

# Database
POSTGRES_USER=sahyog
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sahyog
DATABASE_URL=postgresql://sahyog:change-me-locally@localhost:5432/sahyog
