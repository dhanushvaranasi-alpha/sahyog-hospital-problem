# Copy to .env and fill in locally. .env is git-ignored.

# LLM access (de-identified text only) — see docs/architecture.md decisions 5–7, 15
OPENROUTER_API_KEY=
# Chosen by the W1 model comparison (ADR 0004)
LLM_PRIMARY_MODEL=anthropic/claude-haiku-5.5
LLM_FALLBACK_MODEL=openai/gpt-6-luna
LLM_BUDGET_USD_HARD_STOP=2.00
# Faithfulness judge (ADR 0007): a different provider from the answer model
JUDGE_MODEL=openai/gpt-6-luna

# Tracing — decision 10
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sahyog-care-companion

# Embeddings — decision 8 (runs locally)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# Optional: a folder holding onnx/model.onnx and onnx/tokenizer.json (otherwise downloaded to the HF cache)
EMBEDDING_MODEL_DIR=

# PHI tagging — ADR 0006. spaCy model for name detection in typed questions
PHI_SPACY_MODEL=en_core_web_lg

# Queue and slot cache — decisions 11 and 16
REDIS_URL=redis://localhost:6379/0

# Database
POSTGRES_USER=sahyog
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=sahyog
DATABASE_URL=postgresql://sahyog:change-me-locally@localhost:5432/sahyog

# API gateway (PR #8) — signs the development tokens; at least 32 characters.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SIGNING_KEY=
UPLOAD_DIR=data/uploads

# Local demo only: enables POST /demo/token, which signs in as one of the three
# synthetic personas from the web page. Leave unset (off) anywhere else.
DEMO_MODE=true
